# Caddy: porta de entrada do Sistema Cadastral na VM.
# DOMINIO vem do .env (ver docker-compose.prod.yml):
#   ":80"                           -> só http, para testar na rede interna
#   "sistemacadastral.codego.com.br" -> https automático (Let's Encrypt)

{$DOMINIO}

encode gzip

# Envio do documento assinado + documentos do requerimento (até 10MB cada).
request_body {
	max_size 120MB
}

# API (backend FastAPI)
handle /api/* {
	reverse_proxy backend:8000
}

# Site (pasta frontend/)
handle {
	root * /srv/frontend
	file_server
}

header {
	X-Content-Type-Options nosniff
	Referrer-Policy strict-origin-when-cross-origin
	-Server
}
