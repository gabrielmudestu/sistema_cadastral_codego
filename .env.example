# --- Banco de Dados (MySQL) ---
MYSQL_HOST=db
MYSQL_PORT=3306
MYSQL_DATABASE=sistema_cadastral_codego
MYSQL_USER=codego_app
MYSQL_PASSWORD=change_me
MYSQL_ROOT_PASSWORD=change_me_root

# --- Backend (FastAPI) ---
APP_ENV=development
APP_SECRET_KEY=change_me_secret
APP_PORT=8000

# --- Publicação (produção na VM, ver deploy/README.md) ---
# Domínio do site. Vazio = só http na porta 80 (teste na rede interna).
# Preenchido (ex.: sistemacadastral.codego.com.br) = https automático pelo Caddy.
DOMINIO=
# Endereços do site que podem chamar a API, separados por vírgula ("*" = qualquer um).
# Em produção: o endereço https do site, ex.: https://sistemacadastral.codego.com.br
CORS_ORIGINS=*

# --- Armazenamento de arquivos ---
UPLOAD_DIR=/app/storage/uploads
SIGNED_DIR=/app/storage/signed
MAX_UPLOAD_SIZE_MB=10

# --- Protocolo do recibo ---
PROTOCOL_PREFIX=REC

# --- Notificação por e-mail ---
# TODOS os documentos assinados são enviados para este e-mail fixo (o e-mail
# da empresa), independente do e-mail que a pessoa preencheu no cadastro.
# Se deixado vazio, cai de volta para o e-mail do cadastro (não recomendado
# em produção).
NOTIFICATION_EMAIL=

# --- E-mail ---
# EMAIL_PROVIDER define qual implementação é usada: "smtp" (Gmail etc,
# usuário+senha/senha de app) ou "outlook_graph" (Outlook/Hotmail via
# Microsoft Graph API com OAuth2 — necessário porque a Microsoft desativou
# a autenticação básica por SMTP para contas pessoais) ou "brevo_api" (Brevo
# pela API web, para hospedagens que bloqueiam SMTP, como o Render grátis).
EMAIL_PROVIDER=smtp

# --- Opção A: SMTP (Gmail, etc.) ---
SMTP_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Sistema Cadastral CODEGO

# --- Opção C: Brevo pela API web (EMAIL_PROVIDER=brevo_api) ---
# Envia por https (porta 443) em vez de SMTP -- necessário em hospedagens que
# bloqueiam as portas de SMTP, como o Render grátis. A chave é criada no painel
# do Brevo em SMTP & API > API Keys (é diferente da senha SMTP). O remetente
# precisa estar verificado no Brevo (Senders & IPs > Senders).
BREVO_API_KEY=
BREVO_SENDER_EMAIL=

# --- Opção B: Outlook/Hotmail via Microsoft Graph (EMAIL_PROVIDER=outlook_graph) ---
# 1. Cadastre um app em portal.azure.com > Microsoft Entra ID > Registros de
#    aplicativo (veja o passo a passo no README).
# 2. Coloque aqui o "Application (client) ID" do app cadastrado.
# 3. Rode: docker compose exec backend python scripts/setup_outlook_auth.py
#    (login único, autoriza o envio em nome da sua conta Outlook).
OUTLOOK_CLIENT_ID=
OUTLOOK_TENANT=consumers
OUTLOOK_SENDER_EMAIL=
OUTLOOK_TOKEN_CACHE_PATH=/app/storage/outlook_token_cache.bin

# --- reCAPTCHA (proteção contra envios automatizados/spam nos formulários) ---
# Desligado por padrão -- útil pra rodar local sem precisar de chaves reais.
RECAPTCHA_ENABLED=false
RECAPTCHA_SECRET_KEY=
