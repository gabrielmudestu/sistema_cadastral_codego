# --- Banco de Dados (MySQL) ---
MYSQL_HOST=db
MYSQL_PORT=3306
MYSQL_DATABASE=sistema_cadastral_codego
MYSQL_USER=codego_app
MYSQL_PASSWORD=change_me
MYSQL_ROOT_PASSWORD=change_me_root

# --- Backend (FastAPI) ---
APP_ENV=development
APP_SECRET_KEY=change_me_secret
APP_PORT=8000

# --- Armazenamento de arquivos ---
UPLOAD_DIR=/app/storage/uploads
SIGNED_DIR=/app/storage/signed
MAX_UPLOAD_SIZE_MB=10

# --- Protocolo do recibo ---
PROTOCOL_PREFIX=REC
