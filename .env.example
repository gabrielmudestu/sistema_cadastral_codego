# --- Banco de Dados (MySQL) ---
MYSQL_HOST=db
MYSQL_PORT=3306
MYSQL_DATABASE=sistema_cadastral_codego
MYSQL_USER=codego_app
MYSQL_PASSWORD=change_me
MYSQL_ROOT_PASSWORD=change_me_root

# --- Backend (FastAPI) ---
APP_ENV=development
APP_SECRET_KEY=change_me_secret
APP_PORT=8000

# --- Armazenamento de arquivos ---
UPLOAD_DIR=/app/storage/uploads
SIGNED_DIR=/app/storage/signed
MAX_UPLOAD_SIZE_MB=10

# --- Protocolo do recibo ---
PROTOCOL_PREFIX=REC

# --- E-mail (SMTP) ---
# Configurado por padrão para Outlook/Office365. Para usar uma conta @outlook.com
# ou @hotmail.com: SMTP_USER é o e-mail completo, SMTP_PASSWORD é a senha da conta
# (ou uma senha de aplicativo, se a verificação em duas etapas estiver ativada).
SMTP_ENABLED=false
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=Sistema Cadastral CODEGO
